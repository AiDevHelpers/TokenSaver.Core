<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TokenSaver.LanguageHelpers.Core\TokenSaver.LanguageHelpers.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Drives pwsh + PSScriptAnalyzer out of process; no PowerShell SDK package reference so the
         library stays runtime-agnostic and uses whatever pwsh/module the machine has installed. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="Nerdbank.GitVersioning" Version="3.10.94" />
  </ItemGroup>
</Project>
