<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TokenSaver.LanguageHelpers.Core\TokenSaver.LanguageHelpers.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- In-process syntax parsing for RunSyntaxChecker; the fix/lint/format ops shell out to
         `dotnet format`, which ships with the SDK and needs no package reference. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="Nerdbank.GitVersioning" Version="3.10.94" />
  </ItemGroup>
  <PropertyGroup>
    <PackageId>AiDevTools.TokenSaver.LanguageHelpers.CSharp</PackageId>
    <AssemblyName>AiDevTools.TokenSaver.LanguageHelpers.CSharp</AssemblyName>
    <RootNamespace>AiDevTools.TokenSaver.LanguageHelpers.CSharp</RootNamespace>
  </PropertyGroup>

</Project>