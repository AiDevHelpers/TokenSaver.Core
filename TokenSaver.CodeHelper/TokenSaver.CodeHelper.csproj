<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.9" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TokenSaver.Config\TokenSaver.Config.csproj" />
    <!-- Needed by WorkspaceIndexService for ContextCleanerService (prompt-cleaning pipeline
         reused for on-demand file-content compression). -->
    <PackageReference Include="AiDevTools.TokenSaver.ContextHelper" Version="1.0.5-alpha" />
    <ProjectReference Include="..\TokenSaver.OllamaIntegration\TokenSaver.OllamaIntegration.csproj" />
    <ProjectReference Include="..\TokenSaver.TokenEconomy\TokenSaver.TokenEconomy.csproj" />
    <ProjectReference Include="..\TokenSaver.Utilities\TokenSaver.Utilities.csproj" />
    <PackageReference Include="AiDevTools.TokenSaver.Common.Models" Version="1.0.5-alpha" />
    <PackageReference Include="AiDevTools.TokenSaver.Common.Contracts" Version="1.0.5-alpha" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\baseline-calibration.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="Nerdbank.GitVersioning" Version="3.10.94" />
  </ItemGroup>
  <PropertyGroup>
    <PackageId>AiDevTools.TokenSaver.CodeHelper</PackageId>
    <AssemblyName>AiDevTools.TokenSaver.CodeHelper</AssemblyName>
    <RootNamespace>AiDevTools.TokenSaver.CodeHelper</RootNamespace>
  </PropertyGroup>

</Project>