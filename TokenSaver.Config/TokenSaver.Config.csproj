<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <!-- Reuses GitignoreFilter (glob engine) and ContextExclusions from the Library. -->
    <ProjectReference Include="..\TokenSaver.Library\TokenSaver.Library.csproj" />
    <ProjectReference Include="..\TokenSaver.Utilities\TokenSaver.Utilities.csproj" />
    <ProjectReference Include="..\TokenSaver.Common.Core\TokenSaver.Common.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="Nerdbank.GitVersioning" Version="3.10.91" />
  </ItemGroup>
</Project>
