<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>c9a2f6b1-3e0a-4f0c-9a2e-6d5b1c8f4a2d</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>run_eval.py</StartupFile>
    <SearchPath>
    </SearchPath>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <ProjectTypeGuids>{888888a0-9f3d-457c-b088-3a5042f75d52}</ProjectTypeGuids>
    <LaunchProvider>Standard Python launcher</LaunchProvider>
    <InterpreterId>{c9a2f6b1-3e0a-4f0c-9a2e-6d5b1c8f4a2d}</InterpreterId>
    <IsWindowsApplication>False</IsWindowsApplication>
    <Name>TokenSaver.RetrievalBenchmark</Name>
    <RootNamespace>TokenSaver.RetrievalBenchmark</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="extract_corpus.py" />
    <Compile Include="rerank_eval.py" />
    <Compile Include="run_benchmark.py" />
    <Compile Include="run_eval.py" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="README.md" />
    <Content Include="RERANK-EVAL.md" />
    <Content Include="RESULTS.md" />
    <Content Include="PRODUCTION-EVAL.md" />
    <Content Include="corpus.jsonl" />
    <Content Include="queries.jsonl" />
    <Content Include="queries_sample.jsonl" />
  </ItemGroup>
  <ItemGroup>
    <Interpreter Include=".venv\">
      <Id>{c9a2f6b1-3e0a-4f0c-9a2e-6d5b1c8f4a2d}</Id>
      <Version>3.11</Version>
      <Description>.venv (Python 3.11.9 (64-bit))</Description>
      <InterpreterPath>Scripts\python.exe</InterpreterPath>
      <WindowsInterpreterPath>Scripts\pythonw.exe</WindowsInterpreterPath>
      <PathEnvironmentVariable>PYTHONPATH</PathEnvironmentVariable>
      <Architecture>X64</Architecture>
    </Interpreter>
  </ItemGroup>
  <PropertyGroup>
    <PtvsTargetsPath>$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets</PtvsTargetsPath>
  </PropertyGroup>
  <!-- Only present inside full Visual Studio with the Python workload installed — `dotnet build`
       (used for the rest of this solution) doesn't ship these targets. Fall back to no-op
       Build/Clean targets so `dotnet build/clean TokenSaver.slnx` doesn't fail on this project;
       VS still gets full PTVS behavior (IntelliSense, debugging, etc.) when it's present. -->
  <Import Project="$(PtvsTargetsPath)" Condition="Exists('$(PtvsTargetsPath)')" />
  <Target Name="Build" Condition="!Exists('$(PtvsTargetsPath)')" />
  <Target Name="Clean" Condition="!Exists('$(PtvsTargetsPath)')" />
  <Target Name="Rebuild" Condition="!Exists('$(PtvsTargetsPath)')" />
  <!-- Uncomment the CoreCompile target to enable the Build command in Visual Studio and MSBuild to
       validate your Python code without actually running python.exe. This is enabled by default when
       running from within VS. -->
  <!--<Target Name="CoreCompile" />-->
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
</Project>